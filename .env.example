# Параметры окружения. Скопируй в .env и заполни — .env в git не попадает.
#
#   cp .env.example .env
#
# Makefile подхватывает .env сам и раздаёт значения туда, где они нужны:
# в манифесты установки, в секреты кластера и в сквозные проверки.
# Ничего из этого не требуется, чтобы поднять локальное окружение и
# прогнать `make e2e` — только для облачной части (M3).

# ─── Yandex Cloud ───────────────────────────────────────────────────────
# Ключ сервисного аккаунта, файл JSON, как его отдаёт
#   yc iam key create --service-account-name <имя> --output key.json
# Права нужны: compute.editor и vpc.user в папке ниже.
YC_KEY_FILE=

# Где создавать. Каталог (folder) — обязательно; облако нужно провайдеру.
YC_CLOUD_ID=
YC_FOLDER_ID=

# Зона и подсеть, в которых поднимать машины. Подсеть должна выдавать
# внешний адрес или иметь NAT: агент ходит наружу сам, входящий доступ к
# нему не нужен.
YC_ZONE=ru-central1-a
YC_SUBNET_ID=

# Образ, с которого поднимать ВМ. Нужен cloud-init — у образов Yandex он
# есть. Узнать актуальный id семейства:
#   yc compute image get-latest-from-family ubuntu-2404-lts --folder-id standard-images
YC_IMAGE_ID=

# ─── Достижимость на время разработки ───────────────────────────────────
# Публичная машина, через которую пробрасывается туннель. Локальный
# кластер остаётся у тебя; наружу торчит только этот туннель и только
# пока идёт проверка.
#
# Это леса ради проверки, а не то, как система будет ставиться у людей —
# настоящая раскладка управляющего слоя это работа M7.
TUNNEL_SSH=            # например ubuntu@203.0.113.10
TUNNEL_SSH_KEY=        # путь к приватному ключу, пусто — ключ по умолчанию

# Имя или адрес, по которому созданная ВМ достучится до туннеля. Обычно
# тот же публичный адрес, что и в TUNNEL_SSH, но без имени пользователя.
TUNNEL_PUBLIC_HOST=

# Порты на публичной машине. Меняй, если они там заняты.
TUNNEL_TEMPORAL_PORT=7233
TUNNEL_DIST_PORT=18080

# ─── Существующая машина для MachineIntent ──────────────────────────────
# Машина, которая уже есть и до которой есть ssh. На ней проверяется, что
# система работает не только с тем, что создала сама.
SSH_MACHINE=           # например ubuntu@203.0.113.20
SSH_MACHINE_KEY=       # путь к приватному ключу
