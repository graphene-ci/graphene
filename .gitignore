# Инструменты, поставленные `make configure`.
/bin/

# Собранные бинари. Ведущий слэш обязателен: без него шаблон съел бы
# каталог cmd/graphene с тем же именем.
/graphene
/graphene-operator
/graphene-worker
/graphene-agent

# Собранные примеры. У каждого примера свой модуль, и `go build` в его
# каталоге кладёт бинарь рядом с исходником — на этом уже обжигались
# дважды, второй раз на 71 мегабайте.
/examples/*/[a-z]*
!/examples/*/*.go
!/examples/*/go.mod
!/examples/*/go.sum

# Ключ сервисного аккаунта облака. Лежит рядом, потому что так его
# отдаёт `yc iam key create`, и не должен иметь ни одного шанса уехать
# в историю.
/key.json
*.key.json

# Параметры окружения: ключи облака и адреса. Образец — в .env.example,
# и он в git есть; заполненный .env не должен там оказаться никогда.
/.env

# Локальное состояние окружения.
/.kubeconfig
/.operator-image
/.worker-image

# Бинарь агента, который make install кладёт в образ оператора.
/cmd/graphene-operator/kodata/
