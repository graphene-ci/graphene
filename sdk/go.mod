// SDK: то, что импортирует ПОЛЬЗОВАТЕЛЬ.
//
// Отдельный модуль, и это не удобство, а необходимость. Пайплайн живёт в
// репозитории пользователя вместе с провайдерами Crossplane, у которых
// свои пины: провайдер Yandex прибит к предрелизной crossplane-runtime,
// собирающейся только с controller-runtime ≤0.23, а нашему оператору
// нужен 0.24. Пока SDK был в одном модуле с оператором, версия
// controller-runtime продукта определялась пином первого попавшегося
// провайдера — и следующий провайдер открывал бы этот спор заново.
//
// Здесь controller-runtime нет вообще, и это проверяет
// pipeline/imports_test.go. Что возьмёт пользователь — дело пользователя.
module github.com/graphene-ci/graphene/sdk

go 1.26.0

require (
	go.temporal.io/api v1.63.4
	go.temporal.io/sdk v1.47.0
	k8s.io/apiextensions-apiserver v0.35.7
	k8s.io/apimachinery v0.35.7
)

require (
	github.com/cenkalti/backoff/v5 v5.0.3 // indirect
